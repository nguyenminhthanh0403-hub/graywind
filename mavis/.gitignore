.venv/
__pycache__/
*.pyc
.env
# Avatar models are excluded by default and allowed back one at a time.
# This repo is PUBLIC, so committing a model republishes it under the owner's
# name. Only assets whose licence actually permits redistribution get an
# unignore line below, and each one must be recorded in ATTRIBUTION.md.
# Build artifacts (*_fixed.glb, *.bam) are regenerable and never committed.
assets/avatar/*
!assets/avatar/ATTRIBUTION.md
!assets/avatar/jonny.glb
# Generated Johnny speech: cloned audio in a hired voice actor's voice, and
# this repo is public. The generator and the line text are committed; the wavs
# are rebuilt with `scripts/pregen_lines.py`.
assets/voice/*
!assets/voice/ATTRIBUTION.md
.venv
